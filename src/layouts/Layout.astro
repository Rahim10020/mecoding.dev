---
import "@/styles/global.css";

import Analytics from "@vercel/analytics/astro";

import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { site } from "@/data/site";
import { siteSchema } from "@/lib/schema";

interface Props {
  title?: string;
  description?: string;
  /** Image Open Graph relative à la racine du site. */
  image?: string;
  /** Texte alternatif de l'image Open Graph. */
  imageAlt?: string;
  /** Nœuds JSON-LD supplémentaires, ajoutés au graphe global. */
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
  /** Le shell (header + footer) est rendu par défaut. La home le compose elle-même. */
  shell?: boolean;
  /** Classes additionnelles du header du shell (ex. `sticky top-0`). */
  headerClass?: string;
}

/** Carte de partage par défaut : 1200 × 630, servie depuis `public/`. */
const DEFAULT_OG_IMAGE = "/images/og-image.jpg";
const DEFAULT_OG_ALT = "Rahim ALI — Web developer and UX/UI designer";

const {
  title = site.title,
  description = site.description,
  image = DEFAULT_OG_IMAGE,
  imageAlt = DEFAULT_OG_ALT,
  structuredData = [],
  noindex = false,
  shell = true,
  headerClass,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [...siteSchema(), ...structuredData],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link
      rel="preload"
      href="/fonts/rethink-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>

  <body>
    {shell ? <Header class={headerClass} /> : <slot name="header" />}

    <main id="main">
      <slot />
    </main>

    {shell ? <Footer /> : <slot name="footer" />}

    <Analytics />
  </body>
</html>
