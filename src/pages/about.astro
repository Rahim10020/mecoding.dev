---
import { getCollection } from "astro:content";

import AboutContact from "@/components/about/AboutContact.astro";
import AboutList from "@/components/about/AboutList.astro";
import AboutStatement from "@/components/about/AboutStatement.astro";
import Frame from "@/components/layout/Frame.astro";
import { about } from "@/data/about";
import { site } from "@/data/site";
import Layout from "@/layouts/Layout.astro";

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);

const selectedWork = projects.map((project) => ({
  name: project.data.title,
  detail: `${project.data.category} — ${project.data.year}`,
  href: `/projects/${project.id}`,
}));
---

<Layout
  title="About — mecoding"
  description="About Rahim ALI — web developer and UX/UI designer based in Lomé, Togo, working between design, front-end and product."
>
  <Frame class="pb-column pt-column">
    <p class="text-label uppercase text-black-60">
      About — {site.availability}
    </p>

    <div
      class="mt-column grid gap-column lg:grid-cols-12 lg:items-start lg:gap-grid"
    >
      <div class="flex flex-col gap-center lg:col-span-7">
        <AboutStatement />

        <section aria-labelledby="about-expertise">
          <h2
            id="about-expertise"
            class="text-label uppercase text-black-60"
          >
            Expertise
          </h2>
          <p class="mt-stack max-w-2xl text-body text-black-80">
            {about.expertise.join(", ")}
          </p>
        </section>

        <AboutContact />
      </div>

      <div
        class="@container flex flex-col gap-center lg:col-span-4 lg:col-start-9"
      >
        <div class="grid gap-stack @lg:grid-cols-2">
          <AboutList label="Focus" entries={about.focus} />
          <AboutList label="Selected work" entries={selectedWork} />
        </div>

        <AboutList label="Stack" entries={about.stack} columns={2} />

        <AboutList
          label="Certifications"
          entries={about.certifications}
        />
      </div>
    </div>
  </Frame>
</Layout>
