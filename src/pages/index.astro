---
import { getCollection } from "astro:content";

import HomeHero from "@/components/home/HomeHero.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { site } from "@/data/site";
import Layout from "@/layouts/Layout.astro";

const projects = (
  await getCollection(
    "projects",
    ({ data }) => data.featured && !data.draft,
  )
).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  shell={false}
  title={site.title}
  description={site.description}
>
  <Header slot="header" class="fixed inset-x-0 top-0 z-40 bg-white/95" />

  <HomeHero projects={projects} />

  <Footer slot="footer" class="md:fixed md:inset-x-0 md:bottom-0 md:z-40" />
</Layout>
