---
import Footer from "@/components/layout/Footer.astro";
import Frame from "@/components/layout/Frame.astro";
import Header from "@/components/layout/Header.astro";
import ProjectsMasonry from "@/components/projects/ProjectsMasonry.astro";
import Cartoon from "@/components/ui/Cartoon.astro";
import Layout from "@/layouts/Layout.astro";
import { getAllProjects } from "@/lib/projects";

const projects = await getAllProjects();
---

<Layout
  shell={false}
  title="Work — mecoding"
  description="Selected product design and front-end work by Rahim ALI: web platforms, mobile apps and interface systems."
>
  <Header slot="header" class="fixed inset-x-0 top-0 z-40" />

  <section class="relative flex flex-col md:h-svh md:overflow-hidden">
    <Frame
      class="flex min-h-0 flex-1 flex-col justify-end pb-column pt-[5rem] md:pb-0 md:pt-0"
    >
      <div
        class="flex w-full flex-col gap-stack md:h-full md:flex-row md:items-end md:justify-between md:gap-grid"
      >
        <div
          class="order-1 flex w-full max-w-tile flex-col gap-grid md:flex-1 md:gap-meta md:pb-column"
        >
          <p class="text-label text-black-70">
            <span class="text-black">mecoding.</span> — {projects.length} projects
          </p>

          <h1 class="text-statement text-black-60">
            <span class="text-black">Work.</span> Products, interfaces and sites
            designed and built end to end.
          </h1>
        </div>

        <div
          class="order-2 w-full md:order-3 md:max-w-80 md:flex-1 md:pb-column"
        >
          <Cartoon priority />
        </div>

        <ProjectsMasonry projects={projects} />
      </div>
    </Frame>
  </section>

  <Footer slot="footer" class="md:fixed md:inset-x-0 md:bottom-0 md:z-40" />
</Layout>
