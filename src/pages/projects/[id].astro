---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import ExternalLink from "@/components/icons/ExternalLink.astro";
import ArrowRight from "@/components/icons/ArrowRight.astro";
import Frame from "@/components/layout/Frame.astro";
import Button from "@/components/ui/Button.astro";
import Overline from "@/components/ui/Overline.astro";
import Layout from "@/layouts/Layout.astro";
import { getAllProjects } from "@/lib/projects";

export async function getStaticPaths() {
  const projects = await getAllProjects();

  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      next: projects[(index + 1) % projects.length]!,
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  next: CollectionEntry<"projects">;
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<Layout
  title={`${data.title} — mecoding`}
  description={data.description}
>
  <article>
    <Frame class="pt-stack">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-label uppercase text-black-60 transition-colors duration-200 hover:text-black"
      >
        <ArrowRight size={12} class="rotate-180" />
        All projects
      </a>

      <Overline class="mt-column">
        {data.category} — {data.year}
      </Overline>

      <h1 class="mt-meta max-w-4xl text-headline">{data.title}</h1>

      <p class="mt-stack max-w-2xl text-body-lg text-black-60">
        {data.description}
      </p>

      <dl
        class="mt-column grid gap-grid border-t border-black-10 pt-meta sm:grid-cols-3"
      >
        <div>
          <Overline as="dt">Role</Overline>
          <dd class="mt-grid text-body text-black-80">{data.role}</dd>
        </div>
        <div>
          <Overline as="dt">Platform</Overline>
          <dd class="mt-grid text-body text-black-80">{data.platform}</dd>
        </div>
        <div>
          <Overline as="dt">Year</Overline>
          <dd class="mt-grid text-body text-black-80">{data.year}</dd>
        </div>
      </dl>

      {
        data.link && (
        <Button
          href={data.link}
          size="md"
          class="mt-stack rounded-full"
        >
          Visit live site
          <ExternalLink slot="icon-end" size={12} />
        </Button>
        )
      }
    </Frame>

    <Frame class="mt-column grid gap-column pb-column lg:grid-cols-[16rem_1fr]">
      <aside class="hidden lg:block">
        <Overline>Stack</Overline>
        <ul class="mt-grid flex flex-wrap gap-2">
          {
            data.tags.map((tag) => (
              <li class="rounded-full border border-black-10 px-3 py-1 text-label uppercase text-black-60">
                {tag}
              </li>
            ))
          }
        </ul>

        <Overline class="mt-column">Year</Overline>
        <p class="mt-grid text-body text-black-80">{data.year}</p>
      </aside>

      <div class="prose max-w-3xl">
        <Content />
      </div>
    </Frame>

    <Frame class="border-t border-black-10 py-stack">
      <a
        href={`/projects/${next.id}`}
        class="group flex flex-col gap-grid md:flex-row md:items-end md:justify-between"
      >
        <div>
          <Overline>Next project</Overline>
          <p class="mt-meta text-title">{next.data.title}</p>
        </div>
        <ArrowRight
          size={24}
          class="text-black transition-transform duration-300 ease-kelo group-hover:translate-x-1"
        />
      </a>
    </Frame>
  </article>
</Layout>

<style>
  .prose {
    color: var(--color-black-80);
  }

  .prose :global(h2) {
    margin-top: var(--spacing-column);
    color: var(--color-black);
    font-size: var(--text-title);
    font-weight: var(--text-title--font-weight);
    line-height: var(--text-title--line-height);
    letter-spacing: var(--text-title--letter-spacing);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    margin-top: var(--spacing-meta);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }

  .prose :global(strong) {
    color: var(--color-black);
    font-weight: 600;
  }

  .prose :global(ul) {
    margin-top: var(--spacing-meta);
    padding-left: 1.25rem;
    list-style: disc;
  }

  .prose :global(li) {
    margin-top: var(--spacing-grid);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }

  .prose :global(a) {
    color: var(--color-black);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(img),
  .prose :global(video) {
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--spacing-stack);
    background-color: var(--color-black-5);
  }

  .prose :global(video) {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .prose :global(table) {
    width: 100%;
    margin-top: var(--spacing-stack);
    border-collapse: collapse;
    font-size: var(--text-body);
  }

  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px solid var(--color-black-10);
    padding: var(--spacing-grid) 0;
    text-align: left;
  }

  .prose :global(th) {
    color: var(--color-black-50);
    font-size: var(--text-label);
    font-weight: var(--text-label--font-weight);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
  }

  .prose :global(.media-grid) {
    display: grid;
    gap: var(--spacing-grid);
    margin-top: var(--spacing-stack);
  }

  .prose :global(.media-grid.cols-2) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .prose :global(.media-grid.cols-3) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .prose :global(.media-grid img) {
    margin-top: 0;
  }

  @media (max-width: 809px) {
    .prose :global(.media-grid.cols-3) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
