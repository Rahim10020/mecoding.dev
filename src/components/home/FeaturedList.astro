---
import type { CollectionEntry } from "astro:content";

import ArrowUpRight from "@/components/icons/ArrowUpRight.astro";
import Frame from "@/components/layout/Frame.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section class="md:hidden" aria-labelledby="featured-title">
  <Frame class="pb-column pt-stack">
    <p id="featured-title" class="text-label uppercase text-black-60">
      Selected work — {projects.length} projects
    </p>

    <ul class="mt-meta border-t border-black-10">
      {
        projects.map((project) => (
          <li>
            <a
              href={`/projects/${project.id}`}
              class="group flex items-start justify-between gap-stack border-b border-black-10 py-stack"
            >
              <span>
                <span class="block text-label uppercase text-black-60">
                  {project.data.category} — {project.data.year}
                </span>
                <span class="mt-grid block text-title">
                  {project.data.title}
                </span>
              </span>
              <ArrowUpRight
                size={16}
                class="mt-grid shrink-0 text-black transition-transform duration-300 ease-kelo group-hover:-translate-y-1 group-hover:translate-x-1"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </Frame>
</section>
