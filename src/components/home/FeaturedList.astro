---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

import ArrowUpRight from "@/components/icons/ArrowUpRight.astro";
import Frame from "@/components/layout/Frame.astro";
import Button from "@/components/ui/Button.astro";
import Overline from "@/components/ui/Overline.astro";
import Placeholder from "@/components/ui/Placeholder.astro";
import { home } from "@/data/home";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section class="md:hidden" aria-labelledby="featured-title">
  <Frame class="pb-column pt-stack">
    <Overline id="featured-title">
      Selected work — {projects.length} projects
    </Overline>

    <ul class="mt-meta border-t border-black-10">
      {projects.map((project) => (
        <li>
          <a
            href={`/projects/${project.id}`}
            class="group grid grid-cols-[5rem_minmax(0,1fr)_auto] items-start gap-meta border-b border-black-10 py-stack transition-colors duration-200 active:bg-black-5"
          >
            <span class="block size-20 overflow-hidden bg-black-5">
              {project.data.cover ? (
                <Image
                  src={project.data.cover}
                  alt=""
                  width={160}
                  height={160}
                  fit="cover"
                  loading="lazy"
                  class="size-20 object-cover"
                />
              ) : (
                <Placeholder alt="" width={160} height={160} class="size-20" />
              )}
            </span>

            <span class="min-w-0">
              <Overline as="span" class="block">
                {project.data.category} — {project.data.year}
              </Overline>
              <span class="mt-grid block truncate text-title">
                {project.data.title}
              </span>
              <span class="mt-1 block truncate text-body text-black-60">
                {project.data.description}
              </span>
            </span>

            <ArrowUpRight
              size={16}
              class="mt-grid shrink-0 text-black transition-transform duration-300 ease-kelo group-hover:-translate-y-1 group-hover:translate-x-1 group-active:-translate-y-0.5 group-active:translate-x-0.5"
            />
          </a>
        </li>
      ))}
    </ul>

    <Button href={home.cta.href} size="sm" class="mt-stack w-fit">
      {home.cta.label}
      <ArrowUpRight slot="icon-end" size={12} />
    </Button>
  </Frame>
</section>
