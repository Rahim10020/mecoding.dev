---
import type { CollectionEntry } from "astro:content";

import Frame from "@/components/layout/Frame.astro";
import FeaturedList from "@/components/home/FeaturedList.astro";
import ProjectCarousel from "@/components/home/ProjectCarousel.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section class="relative flex flex-col md:h-svh md:overflow-hidden">
  <Frame class="flex flex-1 flex-col justify-end pb-column pt-[5rem] md:pt-0">
    <div
      class="flex w-full flex-col gap-stack md:flex-row md:items-end md:justify-between md:gap-grid"
    >
      <div
        class="flex w-full max-w-tile flex-col gap-grid md:flex-1 md:gap-meta"
      >
        <p class="text-label text-black-70">
          <span class="text-black">mecoding.</span> — Design & development
        </p>

        <h1 class="text-statement text-black-60">
          I design and build{" "}
          <span class="text-black">digital products</span> that make the web{
            " "
          }
          <span class="text-black">simple, intuitive and alive.</span>
        </h1>
      </div>

      <div class="hidden md:block md:flex-[1.5]" aria-hidden="true"></div>

      <div class="w-full md:max-w-80 md:flex-1">
        <div class="block w-full overflow-hidden">
          <img
            src="/images/others/rahim-cartoon.webp"
            width="487"
            height="440"
            alt="Illustration of Rahim"
            fetchpriority="high"
            decoding="async"
            class="h-auto w-full"
          />
        </div>
      </div>
    </div>
  </Frame>

  <ProjectCarousel projects={projects} />
</section>

<FeaturedList projects={projects} />
