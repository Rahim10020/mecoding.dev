---
import type { CollectionEntry } from "astro:content";

import ProjectCard from "@/components/projects/ProjectCard.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;

/**
 * Copies empilées pour la boucle verticale. La copie `ACTIVE` est la seule
 * accessible ; les autres sont des doublons visuels inertes.
 */
const COPIES = 5;
const ACTIVE = 1;

const copies = Array.from({ length: COPIES }, (_, copy) => copy);
---

<div class="order-3 w-full md:order-2 md:flex md:flex-[1.5] md:justify-center md:self-stretch">
  <div
    class="w-full focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-black md:h-full md:max-w-3xl md:cursor-grab md:overflow-hidden md:active:cursor-grabbing"
    role="region"
    aria-label="All projects"
    tabindex="0"
    data-masonry-viewport
  >
    <div class="md:will-change-transform" data-masonry-track>
      {copies.map((copy) => (
        <ul
          class:list={[
            "columns-1 gap-x-6 md:columns-xs",
            copy !== ACTIVE && "hidden md:block",
          ]}
          aria-hidden={copy === ACTIVE ? undefined : "true"}
          data-masonry-copy
        >
          {projects.map((project) => (
            <li class="break-inside-avoid pb-12">
              <ProjectCard project={project} interactive={copy === ACTIVE} />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</div>

<script>
  import { initWorkMasonry } from "@/lib/work-masonry";

  initWorkMasonry();
</script>
