---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

import ArrowUpRight from "@/components/icons/ArrowUpRight.astro";
import Placeholder from "@/components/ui/Placeholder.astro";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;
---

<a
  href={`/projects/${project.id}`}
  id={project.id}
  class="group grid gap-stack border-t border-black-10 py-stack md:grid-cols-[12rem_1fr_auto] md:items-start md:gap-grid"
>
  <div class="aspect-4/3 w-full overflow-hidden border border-black-10 bg-black-5 md:w-48">
    {
      data.cover ? (
        <Image
          src={data.cover}
          alt={data.coverAlt ?? ""}
          width={480}
          height={360}
          fit="cover"
          loading="lazy"
          class="h-full w-full object-cover grayscale transition-[filter] duration-[600ms] ease-kelo group-hover:grayscale-0"
        />
      ) : (
        <Placeholder class="h-full w-full object-cover" />
      )
    }
  </div>

  <div class="flex flex-col gap-grid">
    <p class="text-label uppercase text-black-60">
      {String(index + 1).padStart(2, "0")} — {data.year}
    </p>

    <h2 class="text-title transition-colors duration-200">
      <span class="bg-left-bottom bg-no-repeat [background-image:linear-gradient(currentColor,currentColor)] [background-size:0%_1px] transition-[background-size] duration-300 ease-kelo group-hover:[background-size:100%_1px]">
        {data.title}
      </span>
    </h2>

    <p class="max-w-prose text-body text-black-60">{data.description}</p>

    <p class="text-label uppercase text-black-60">
      {data.category} — {data.platform}
    </p>
  </div>

  <ArrowUpRight
    size={20}
    class="hidden text-black transition-transform duration-300 ease-kelo group-hover:-translate-y-1 group-hover:translate-x-1 md:block"
  />
</a>
