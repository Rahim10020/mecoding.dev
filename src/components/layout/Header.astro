---
import Frame from "@/components/layout/Frame.astro";
import Availability from "@/components/ui/Availability.astro";
import LocalClock from "@/components/ui/LocalClock.astro";
import MobileMenu from "@/components/ui/MobileMenu.astro";
import NavPills from "@/components/ui/NavPills.astro";
import Logo from "@/components/ui/Logo.astro";
import { site } from "@/data/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<header class:list={["w-full", className]}>
  <Frame
    class="flex items-center justify-between gap-stack py-3 md:grid md:grid-cols-3"
  >
    <a href="/" class="flex items-start gap-grid">
      <Logo size={128} class="size-18" />
      <div class="hidden md:block md:justify-self-start">
        <Availability label={site.availability} />
      </div>
    </a>

    <p
      class="hidden text-label uppercase text-black-70 md:block md:justify-self-center"
    >
      {site.location.city}, {site.location.country}
      <span aria-hidden="true"> — </span>
      <LocalClock class="inline" />
    </p>

    <NavPills class="hidden md:block md:justify-self-end" />

    <MobileMenu />
  </Frame>
</header>
