---
import Frame from "@/components/layout/Frame.astro";
import Availability from "@/components/ui/Availability.astro";
import LocalClock from "@/components/ui/LocalClock.astro";
import MobileMenu from "@/components/ui/MobileMenu.astro";
import NavPills from "@/components/ui/NavPills.astro";
import Logo from "@/components/ui/Logo.astro";
import { site } from "@/data/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<header class:list={["w-full", className]}>
  <Frame
    class="flex items-start justify-between gap-stack py-3 md:grid md:grid-cols-3"
  >
    <a href="/" class="flex items-center gap-grid">
      <h1 class="text-7xl font-semibold">rahim</h1>
      <Logo size={64} class="size-12" />
    </a>

    <div class="hidden items-center justify-end gap-meta md:col-span-2 md:flex">
      <p class="text-label text-black-70">
        {site.location.city}, {site.location.country}
        <span aria-hidden="true"> — </span>
        <LocalClock class="inline" />
      </p>

      <NavPills />
    </div>

    <MobileMenu />
  </Frame>
</header>
