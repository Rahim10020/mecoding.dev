---
import Frame from "@/components/layout/Frame.astro";
import SocialLinks from "@/components/ui/SocialLinks.astro";
import { site } from "@/data/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class:list={[
    "sticky bottom-0 z-40 w-full bg-transparent max-md:relative",
    className,
  ]}
>
  <Frame class="flex flex-col gap-meta pb-meta items-center md:flex-row md:items-end md:justify-between md:gap-stack md:pb-gutter">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:gap-stack">
      <slot name="meta" />
      <p class="text-label text-black-70">
        ©{year} {site.name}
      </p>
    </div>

    <SocialLinks />
  </Frame>
</footer>
