---
interface Props {
  id: string;
  label: string;
  class?: string;
  [key: string]: unknown;
}

const { id, label, class: className, ...rest } = Astro.props;
---

<div>
  <label for={id} class="text-body font-semibold">{label}</label>
  <textarea
    id={id}
    class:list={[
      "mt-1 min-h-16 w-full resize-y bg-black-5 pt-2 pl-2 text-body text-black",
      className,
    ]}
    {...rest}
  ></textarea>
</div>
