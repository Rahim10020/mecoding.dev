---
import { site } from "@/data/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ul
  class:list={[
    "flex flex-wrap items-center gap-x-meta gap-y-1 md:gap-x-stack md:gap-y-grid",
    className,
  ]}
>
  {
    site.socials.map((social) => (
      <li>
        <a
          href={social.href}
          rel="noopener noreferrer"
          target="_blank"
          class="inline-block text-label text-black-70 transition-colors duration-200 hover:text-black py-1.5"
        >
          {social.label}
        </a>
      </li>
    ))
  }
</ul>
