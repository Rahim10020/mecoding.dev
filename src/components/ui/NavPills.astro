---
import { site } from "@/data/site";
import ArrowUpRight from "@/components/icons/ArrowUpRight.astro";

interface Props {
  class?: string;
  /** Rend les liens en pills (par défaut) ou en texte simple. */
  variant?: "pills" | "plain";
}

const { class: className, variant = "pills" } = Astro.props;

const isActive = (href: string) => {
  const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
  const target = href.replace(/\/+$/, "") || "/";
  return path === target || path.startsWith(`${target}/`);
};
---

<nav aria-label="Primary" class:list={[className]}>
  <ul
    class:list={[
      "flex items-center",
      variant === "pills" ? "gap-px" : "gap-grid",
    ]}
  >
    {
      site.nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "text-label uppercase transition-colors duration-200",
              variant === "pills" &&
                "inline-flex w-28 items-center justify-between rounded-none border-0 px-3  py-1",
              variant === "pills"
                ? isActive(item.href)
                  ? "bg-black text-white"
                  : "bg-black-10 text-black-70 hover:bg-black-20 hover:text-black"
                : isActive(item.href)
                  ? "text-black"
                  : "text-black-70 hover:text-black",
            ]}
          >
            {item.label}
            {variant === "pills" && isActive(item.href) && (
              <ArrowUpRight size={10} />
            )}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
