---
import Button from "@/components/ui/Button.astro";
import NavPills from "@/components/ui/NavPills.astro";
import Close from "@/components/icons/Close.astro";
import Menu from "@/components/icons/Menu.astro";
import Logo from "@/components/ui/Logo.astro";
import { routes } from "@/lib/routes";
---

<div class="md:hidden" data-menu-root>
  <Button
    type="button"
    variant="ghost"
    size="none"
    aria-expanded="false"
    aria-controls="mobile-menu"
    data-menu-toggle
    class="-m-2 p-2 text-black"
  >
    <span>Menu</span>
    <Menu slot="icon-end" class="text-black" size={16} />
  </Button>

  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 flex flex-col bg-white"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
    hidden
    data-menu-panel
  >
    <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between px-gutter py-gutter">
      <a href={routes.home} class="flex items-center gap-grid" data-menu-link>
        <Logo size={32} />
      </a>

      <Button
        type="button"
        variant="ghost"
        size="none"
        data-menu-close
        class="-m-2 p-2 text-black"
      >
        <span>Close</span>
        <Close slot="icon-end" class="text-black" size={16} />
      </Button>
    </div>

    <div class="flex flex-1 items-center justify-center px-gutter">
      <NavPills
        variant="plain"
        class="[&_a]:text-display [&_a]:normal-case [&_a]:tracking-[-0.02em]"
      />
    </div>
  </div>
</div>

<noscript>
  <NavPills variant="plain" class="md:hidden" />
</noscript>

<style>
  /*
   * Rideau : le panneau descend depuis le haut du viewport. `hidden`
   * (display: none) interdit toute transition, donc l'ouverture est
   * déclenchée en JS par `data-open` après un recalcul de style, et la
   * fermeture rejoue la transition inverse avant que `hidden` revienne.
   */
  [data-menu-panel] {
    transform: translateY(-100%);
    transition: transform 420ms var(--ease-soft);
    pointer-events: none;
  }

  [data-menu-panel][data-open] {
    transform: translateY(0);
    transition-duration: 500ms;
    pointer-events: auto;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-menu-root]");
  const toggle = root?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = root?.querySelector<HTMLElement>("[data-menu-panel]");
  const close = root?.querySelector<HTMLButtonElement>("[data-menu-close]");

  if (root && toggle && panel && close) {
    /** Durée de sortie du rideau, alignée sur le `transition` ci-dessus. */
    const CLOSE_MS = 420;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    /** Applique `hidden` une fois le rideau sorti. */
    let closeTimer: number | undefined;

    const isOpen = () => panel.hasAttribute("data-open");

    const setOpen = (open: boolean) => {
      window.clearTimeout(closeTimer);
      toggle.setAttribute("aria-expanded", String(open));

      if (open) {
        panel.hidden = false;
        // Force le calcul du style de départ (translateY(-100%)) : sans ce
        // recalcul, quitter `display: none` et poser `data-open` dans la même
        // frame ne transitionne pas.
        void panel.offsetHeight;
        panel.dataset.open = "";
        document.documentElement.style.overflow = "hidden";

        // `preventScroll` évite de remonter la page derrière le panneau.
        close.focus({ preventScroll: true });
        return;
      }

      // Retire l'état visuel : le rideau remonte, puis `hidden` est appliqué.
      delete panel.dataset.open;
      toggle.focus({ preventScroll: true });

      if (reduceMotion.matches) {
        panel.hidden = true;
        document.documentElement.style.overflow = "";
        return;
      }

      // La page reste verrouillée pendant la sortie du rideau.
      closeTimer = window.setTimeout(() => {
        panel.hidden = true;
        document.documentElement.style.overflow = "";
      }, CLOSE_MS);
    };

    toggle.addEventListener("click", () => setOpen(true));
    close.addEventListener("click", () => setOpen(false));

    panel
      .querySelectorAll<HTMLElement>("[data-menu-link], nav a")
      .forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });

    document.addEventListener("keydown", (event) => {
      // Pendant la sortie, le panneau n'est plus `hidden` mais n'est plus
      // ouvert : le piège de focus ne doit pas reprendre la main.
      if (!isOpen()) return;

      if (event.key === "Escape") {
        setOpen(false);
        return;
      }

      if (event.key !== "Tab") return;

      // Piège le focus à l'intérieur du panneau.
      const focusable = Array.from(
        panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((element) => element.offsetParent !== null);

      if (focusable.length === 0) return;

      const first = focusable[0]!;
      const last = focusable[focusable.length - 1]!;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // La panneau n'existe qu'en dessous de md : on le referme au redimensionnement.
    window
      .matchMedia("(min-width: 810px)")
      .addEventListener("change", (event) => {
        if (event.matches && isOpen()) {
          setOpen(false);
        }
      });
  }
</script>
