---
interface Props {
  /** Charge l'image en priorité (LCP de la page). */
  priority?: boolean;
}

const { priority = false } = Astro.props;
---

<div class="block w-full max-md:mx-auto max-md:max-w-60 overflow-hidden">
  <img
    src="/images/others/rahim-cartoon.webp"
    width="587"
    height="440"
    alt="Illustration of Rahim"
    fetchpriority={priority ? "high" : undefined}
    loading={priority ? undefined : "lazy"}
    decoding="async"
    class="h-auto w-full"
  />
</div>
