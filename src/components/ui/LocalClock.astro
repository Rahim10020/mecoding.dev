---
import { site } from "@/data/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<time
  class:list={["tabular-nums text-label uppercase text-black-70", className]}
  datetime={new Date().toISOString()}
  data-clock
  data-time-zone={site.location.timeZone}
>
  --:--
</time>

<script>
  const zones = () => document.querySelectorAll<HTMLElement>("[data-clock]");

  const render = (el: HTMLElement) => {
    const zone = el.dataset.timeZone;
    if (!zone) return;

    const now = new Date();
    el.textContent = new Intl.DateTimeFormat("en", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: true,
      timeZone: zone,
    }).format(now);
    el.setAttribute("datetime", now.toISOString());
  };

  const tick = () => zones().forEach(render);

  tick();
  window.setInterval(tick, 30_000);
</script>
