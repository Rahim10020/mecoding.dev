---
import { about } from "@/data/about";
---

<div>
  <h1 class="max-w-4xl text-title">
    {about.statement}
  </h1>

  <div class="mt-stack flex max-w-2xl flex-col gap-meta">
    {
      about.bio.map((paragraph) => (
        <p class="text-body text-black-70">{paragraph}</p>
      ))
    }
  </div>
</div>
