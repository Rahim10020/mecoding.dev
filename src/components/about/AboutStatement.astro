---
import { about } from "@/data/about";
---

<div>
  <h1 class="max-w-4xl text-headline">
    {about.statement}
  </h1>

  <div class="mt-stack flex max-w-2xl flex-col gap-meta">
    {
      about.bio.map((paragraph) => (
        <p class="text-body lg:text-body-lg font-medium text-black-80">
          {paragraph}
        </p>
      ))
    }
  </div>
</div>
