---
import ArrowUpRight from "@/components/icons/ArrowUpRight.astro";
import { about } from "@/data/about";
import { site } from "@/data/site";

const usesEndpoint = site.contact.accessKey.length > 0;
const action = usesEndpoint ? site.contact.endpoint : `mailto:${site.email}`;

const fieldClass =
  "w-full border-b border-black-10 bg-transparent pb-1 text-body text-black transition-colors duration-200 hover:border-black-20 focus:border-black";

const highlightClass =
  "inline-block max-w-full bg-black px-1 text-white transition-colors duration-200 hover:bg-black-80";
---

<section
  aria-labelledby="about-contact-title"
  class="grid gap-column md:grid-cols-[minmax(0,36rem)_13rem] md:gap-center"
>
  <div>
    <h2
      id="about-contact-title"
      class="text-label uppercase text-black-60"
    >
      Get in touch
    </h2>

    <form
      action={action}
      method="post"
      enctype={usesEndpoint ? undefined : "text/plain"}
      class="mt-stack flex flex-col gap-stack"
    >
      {
        usesEndpoint && (
          <>
            <input
              type="hidden"
              name="access_key"
              value={site.contact.accessKey}
            />
            <input
              type="hidden"
              name="subject"
              value={site.contact.subject}
            />
            <input type="hidden" name="from_name" value={site.name} />
            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />
          </>
        )
      }

      <div class="grid gap-grid sm:grid-cols-[6rem_1fr] sm:items-baseline">
        <label for="contact-name" class="text-body font-semibold">
          Full name
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          class={fieldClass}
        />
      </div>

      <div class="grid gap-grid sm:grid-cols-[6rem_1fr] sm:items-baseline">
        <label for="contact-email" class="text-body font-semibold">
          Email
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          class={fieldClass}
        />
      </div>

      <div>
        <label for="contact-message" class="text-body font-semibold">
          Message
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="4"
          required
          class="mt-grid min-h-28 w-full resize-y bg-black-5 p-2 text-body text-black"
        ></textarea>
      </div>

      <button
        type="submit"
        class="inline-flex w-fit items-center gap-1 bg-black px-2 py-1 text-label uppercase text-white transition-colors duration-200 hover:bg-black-80"
      >
        Send
        <ArrowUpRight size={10} />
      </button>
    </form>
  </div>

  <div class="flex flex-col gap-stack">
    <div>
      <h3 class="text-label uppercase text-black-60">Contact</h3>
      <ul class="mt-meta flex flex-col items-start gap-1 text-body">
        <li>
          <a href={`mailto:${site.email}`} class={highlightClass}>
            {site.email}
          </a>
        </li>
        <li>
          <a href={site.phoneHref} class={highlightClass}>
            {site.phone}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h3 class="text-label uppercase text-black-60">Location</h3>
      <address class="mt-meta flex flex-col items-start gap-1 text-body not-italic">
        <span class={highlightClass}>{site.location.city},</span>
        <span class={highlightClass}>{site.location.country}</span>
      </address>
    </div>

    <div>
      <h3 class="text-label uppercase text-black-60">Languages</h3>
      <p class="mt-meta text-body text-black-80">
        {about.languages.join(", ")}
      </p>
    </div>
  </div>
</section>
